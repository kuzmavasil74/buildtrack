DATABASE_URL=postgres://buildtrack:buildtrack@localhost:5432/buildtrack
PORT=4000
JWT_SECRET=change-me-to-a-long-random-secret
MONGO_URI=mongodb://localhost:27017/buildtrack
FRONTEND_URL=http://localhost:5173

# Set to "disable" when DATABASE_URL points at a local Postgres without SSL
# (e.g. the docker-compose service). Leave unset in production (Render).
PGSSL=disable

# Required only for the /receipts endpoints (AWS S3 upload)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
